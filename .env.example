# ============================================================
# EXEMPLO DE CONFIGURAÇÃO (ALMOXARIFADO INTELIGENTE)
# Copie para `.env` e ajuste — a app NÃO lê este arquivo automaticamente:
# estas variáveis são consumidas diretamente pelo ambiente de execução
# (Windows, Linux, Docker, Render, etc.).
# ============================================================

# ---------- Servidor ----------
# Porta HTTP (o Render injeta o PORT automaticamente; local = 3000)
PORT=3000

# Host de escuta. Por padrão localhost quando PORT não é injetado;
# em containers/PaaS defina 0.0.0.0.
HOST=0.0.0.0

# ---------- Banco de dados ----------
# Motor: 'sqlite' (padrão) ou 'postgres'
DB_DRIVER=sqlite

# Com SQLite: caminho do arquivo .db (padrão: ./voltstock.db na raiz).
# Ao informar explicitamente, o sistema NÃO recupera backups no boot.
ALMOX_DB_PATH=./voltstock.db

# Com Postgres: URL completa de conexão (configura o driver pg).
DATABASE_URL=postgres://usuario:senha@host:5432/almoxarifado

# Desliga a recuperação automática de backups no boot (uso em testes/rotinas).
# ALMOX_NO_RECOVER=1

# ---------- Credenciais ----------
# Senha do administrador master 'anderson'. Somente usada no primeiro boot
# (seed idempotente). Padrão local: 123456
ALMOX_ADMIN_PASSWORD=troque-esta-senha

# Configuração do Google Drive (OAuth). NÃO versionar o arquivo real.
# ALMOX_CONFIG_PATH=./nuvem_config.json

# ---------- Backups ----------
# Somente SQLite (driver PostgreSQL usa snapshots/restauração nativos).
# Limites e intervalos são internos (config.js), mas os dados ficam em:
# ./backups, ./atualizacao_pendente, ./backups/programa