{
  "name": "almoxarifado-inteligente",
  "version": "1.0.0",
  "description": "Sistema inteligente de gestão de almoxarifado com backup automático, sincronização Google Drive, chat privado, auditoria completa e atualização over-the-air",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint . --ext .js",
    "lint:fix": "eslint . --ext .js --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky install"
  },
  "keywords": [
    "almoxarifado",
    "estoque",
    "gestao",
    "sqlite",
    "express",
    "backup",
    "google-drive",
    "pwa"
  ],
  "author": "Victor Hugo <victorhugoeng@email.com>",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "eslint": "^8.57.0",
    "prettier": "^3.2.5",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11"
  }
}
