{
  "name": "almoxarifado-inteligente",
  "version": "1.0.0",
  "description": "Sistema inteligente de gestão de almoxarifado com backup automático, sincronização Google Drive, chat privado, auditoria completa e atualização over-the-air",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "node --test",
    "audit": "npm audit --audit-level=high",
    "prepare": "husky || exit 0"
  },
  "keywords": [
    "almoxarifado",
    "estoque",
    "gestao",
    "sqlite",
    "express",
    "backup",
    "google-drive",
    "pwa"
  ],
  "author": "Victor Hugo <330597751+VictorHugoEng@users.noreply.github.com>",
  "license": "MIT",
  "type": "commonjs",
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "express": "^5.2.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.10.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.0",
    "globals": "^17.12.0",
    "husky": "^9.1.7",
    "prettier": "^3.9.0"
  }
}
